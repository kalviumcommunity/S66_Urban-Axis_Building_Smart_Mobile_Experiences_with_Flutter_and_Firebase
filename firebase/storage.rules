rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Community logos ─────────────────────────
    match /communities/{communityId}/logo/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && isSuperAdminOf(communityId)
        && isImage(request.resource)
        && request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    // ── Community documents (PDFs) ──────────────
    match /communities/{communityId}/documents/{fileName} {
      allow read: if request.auth != null
        && isActiveMemberOf(communityId);

      allow write: if request.auth != null
        && isSuperAdminOf(communityId)
        && isPDF(request.resource)
        && request.resource.size < 20 * 1024 * 1024; // 20 MB
    }

    // ── Resident profile photos ──────────────────
    match /communities/{communityId}/profiles/{fileName} {
      allow read: if request.auth != null
        && isActiveMemberOf(communityId);

      allow write: if request.auth != null
        && isActiveMemberOf(communityId)
        && isImage(request.resource)
        && request.resource.size < 3 * 1024 * 1024; // 3 MB
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ── Functions ───────────────────────────────

    function isImage(resource) {
      return resource.contentType.matches('image/.*');
    }

    function isPDF(resource) {
      return resource.contentType == 'application/pdf';
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdminOf(communityId) {
      let user = getUserData();
      return user.role == 'superadmin' && user.communityId == communityId && user.status == 'active';
    }

    function isActiveMemberOf(communityId) {
      let user = getUserData();
      return user.communityId == communityId && user.status == 'active';
    }
  }
}
