# ─── Firebase Project ─────────────────────────
PROJECT_ID=urbanaxis-app
CLIENT_EMAIL=your-service-account@urbanaxis-app.iam.gserviceaccount.com
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Cloud Storage ────────────────────────────
STORAGE_BUCKET=urbanaxis-app.appspot.com

# ─── App Config ───────────────────────────────
NODE_ENV=production
API_VERSION=v1

# ─── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
